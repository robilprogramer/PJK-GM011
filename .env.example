# ─── App ──────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=ganti_dengan_random_string_minimal_32_karakter

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/siagaai

# ─── Groq (PRIMARY — Llama 3.3 70B, GRATIS) ──────────────────
# Daftar: https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Default LLM Model ────────────────────────────────────────
# Pilihan groq: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
DEFAULT_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_HISTORY_LIMIT=10

# ─── OpenAI (OPSIONAL) ────────────────────────────────────────
OPENAI_API_KEY=

# ─── Google Gemini (OPSIONAL, GRATIS) ─────────────────────────
# Daftar: https://aistudio.google.com
GEMINI_API_KEY=

# ─── OpenWeatherMap (WAJIB untuk cuaca real-time) ─────────────
# Daftar gratis: https://openweathermap.org/api
OWM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── BMKG (tidak perlu API key) ───────────────────────────────
BMKG_GEMPA_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
BMKG_GEMPA_LIST_URL=https://data.bmkg.go.id/DataMKG/TEWS/gempaterkini.json
BMKG_CUACA_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca

# ─── ChromaDB ─────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=siagaai_knowledge

# ─── HTTP ─────────────────────────────────────────────────────
HTTP_TIMEOUT=15
HTTP_RETRIES=3