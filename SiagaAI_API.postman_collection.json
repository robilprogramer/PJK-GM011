{
  "info": {
    "name": "SiagaAI API — Complete Collection",
    "description": "Koleksi lengkap endpoint SiagaAI. Multi-model (Groq/Llama, OpenAI, Gemini), RAG knowledge base, chat, lokasi, dan eskalasi darurat.\n\nSetup:\n1. Set variable `base_url` = `http://localhost:8000`\n2. Jalankan [Chat] Buat Sesi Baru terlebih dahulu\n3. `session_id` dan `escalation_id` tersimpan otomatis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8000" },
    { "key": "session_id",    "value": "" },
    { "key": "escalation_id", "value": "" }
  ],
  "item": [
    {
      "name": "🏠 Root & Health",
      "item": [
        {
          "name": "Root — Info API",
          "request": { "method": "GET", "url": "{{base_url}}/",
            "description": "Info dasar API + default model yang aktif." }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{base_url}}/api/health",
            "description": "Cek status database, BMKG, OWM, dan daftar model aktif." }
        }
      ]
    },
    {
      "name": "🤖 Models",
      "item": [
        {
          "name": "Daftar Semua Model",
          "request": { "method": "GET", "url": "{{base_url}}/api/models",
            "description": "Tampilkan semua model yang terdaftar (aktif maupun tidak)." }
        },
        {
          "name": "Daftar Model Aktif Saja",
          "request": { "method": "GET", "url": "{{base_url}}/api/models/active",
            "description": "Hanya model yang memiliki API key terkonfigurasi di .env." }
        },
        {
          "name": "Detail Model — Llama 3.3 70B",
          "request": { "method": "GET", "url": "{{base_url}}/api/models/llama-3.3-70b-versatile" }
        },
        {
          "name": "Detail Model — Llama 3.1 8B (Cepat)",
          "request": { "method": "GET", "url": "{{base_url}}/api/models/llama-3.1-8b-instant" }
        },
        {
          "name": "Detail Model — Mixtral 8x7B",
          "request": { "method": "GET", "url": "{{base_url}}/api/models/mixtral-8x7b-32768" }
        },
        {
          "name": "Test Koneksi Model — Llama 3.3",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/models/test?model_id=llama-3.3-70b-versatile",
            "description": "Kirim pesan test ke model untuk verifikasi koneksi dan API key."
          }
        },
        {
          "name": "Test Koneksi Model — Llama 8B",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/models/test?model_id=llama-3.1-8b-instant"
          }
        }
      ]
    },
    {
      "name": "💬 Chat",
      "item": [
        {
          "name": "[1] Buat Sesi — Llama 3.3 70B (Default)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.success && r.data.session_id) {",
              "  pm.collectionVariables.set('session_id', r.data.session_id);",
              "  console.log('Session ID:', r.data.session_id);",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/sessions",
            "body": { "mode": "raw", "raw": "{\n  \"location\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\",\n    \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"model_name\": \"llama-3.3-70b-versatile\"\n}" },
            "description": "Buat sesi baru dengan model Llama 3.3 70B via Groq."
          }
        },
        {
          "name": "[2] Buat Sesi — Llama 3.1 8B (Cepat)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.success && r.data.session_id) pm.collectionVariables.set('session_id', r.data.session_id);"
            ], "type": "text/javascript" }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/sessions",
            "body": { "mode": "raw", "raw": "{\n  \"location\": {\n    \"lat\": -6.9147,\n    \"lng\": 107.6098,\n    \"city\": \"Bandung\",\n    \"province\": \"Jawa Barat\",\n    \"display_name\": \"Bandung, Jawa Barat\"\n  },\n  \"model_name\": \"llama-3.1-8b-instant\"\n}" },
            "description": "Buat sesi dengan model yang lebih ringan dan cepat."
          }
        },
        {
          "name": "[3] Kirim Pesan — Cek Risiko Lokasi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Bagaimana kondisi cuaca dan risiko bencana di lokasi saya sekarang?\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"llama-3.3-70b-versatile\",\n  \"location\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\",\n    \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"history\": []\n}",
            "description": "Kirim pesan pertama — cek risiko real-time." }
          }
        },
        {
          "name": "[4] Kirim Pesan — Ganti Model per Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Apa yang harus saya siapkan dalam tas siaga bencana?\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"mixtral-8x7b-32768\",\n  \"location\": null,\n  \"history\": []\n}",
            "description": "Ganti model ke Mixtral untuk request ini saja. Sistem dinamis!" }
          }
        },
        {
          "name": "[5] Kirim Pesan — Panduan Evakuasi Banjir",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Air mulai masuk ke rumah saya. Bagaimana cara evakuasi yang benar?\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"llama-3.3-70b-versatile\",\n  \"location\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\",\n    \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"history\": []\n}" }
          }
        },
        {
          "name": "[6] Kirim Pesan — Situasi Darurat (Trigger Escalation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"TOLONG! Saya terjebak di lantai 1, banjir sudah sepinggang, tidak bisa keluar!\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"llama-3.1-8b-instant\",\n  \"location\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\",\n    \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"history\": []\n}",
            "description": "Pesan darurat — requires_escalation akan true, gunakan Llama 8B untuk respons cepat." }
          }
        },
        {
          "name": "[7] Kirim Pesan — Edukasi Mitigasi (Tanpa Lokasi)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Bagaimana tanda-tanda tanah longsor akan terjadi?\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"llama-3.3-70b-versatile\",\n  \"location\": null,\n  \"history\": []\n}" }
          }
        },
        {
          "name": "[8] Kirim Pesan — Multi-turn (Dengan History)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/chat/send",
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Lalu apa yang harus saya lakukan setelah banjir surut?\",\n  \"session_id\": \"{{session_id}}\",\n  \"model_name\": \"llama-3.3-70b-versatile\",\n  \"location\": {\n    \"lat\": -6.2088, \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\", \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"history\": [\n    { \"role\": \"user\", \"content\": \"Bagaimana evakuasi saat banjir?\" },\n    { \"role\": \"assistant\", \"content\": \"Saat banjir, pertama matikan listrik dari panel MCB...\" }\n  ]\n}",
            "description": "Test multi-turn conversation dengan history." }
          }
        },
        {
          "name": "[9] Ambil Info Sesi",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/chat/sessions/{{session_id}}" }
        },
        {
          "name": "[10] Riwayat Percakapan",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/chat/sessions/{{session_id}}/history" }
        },
        {
          "name": "[11] Tutup Sesi",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/chat/sessions/{{session_id}}" }
        }
      ]
    },
    {
      "name": "📍 Location",
      "item": [
        {
          "name": "Status Cuaca & Risiko — Jakarta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/location/status",
            "body": { "mode": "raw", "raw": "{\n  \"lat\": -6.2088,\n  \"lng\": 106.8456,\n  \"city\": \"Jakarta Pusat\",\n  \"province\": \"DKI Jakarta\",\n  \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n}" }
          }
        },
        {
          "name": "Status Cuaca & Risiko — Bandung",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/location/status",
            "body": { "mode": "raw", "raw": "{\n  \"lat\": -6.9147,\n  \"lng\": 107.6098,\n  \"city\": \"Bandung\",\n  \"province\": \"Jawa Barat\",\n  \"display_name\": \"Bandung, Jawa Barat\"\n}" }
          }
        },
        {
          "name": "Status Cuaca & Risiko — Surabaya",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/location/status",
            "body": { "mode": "raw", "raw": "{\n  \"lat\": -7.2575,\n  \"lng\": 112.7521,\n  \"city\": \"Surabaya\",\n  \"province\": \"Jawa Timur\",\n  \"display_name\": \"Surabaya, Jawa Timur\"\n}" }
          }
        },
        {
          "name": "Geocode Kota → Koordinat",
          "request": { "method": "GET", "url": "{{base_url}}/api/location/geocode?city=Yogyakarta" }
        },
        {
          "name": "Reverse Geocode → Nama Kota",
          "request": { "method": "GET", "url": "{{base_url}}/api/location/reverse?lat=-6.2088&lng=106.8456" }
        },
        {
          "name": "Gempa Terkini (BMKG) — 5 terakhir",
          "request": { "method": "GET", "url": "{{base_url}}/api/location/earthquakes?limit=5" }
        },
        {
          "name": "Prakiraan Cuaca 24 Jam",
          "request": { "method": "GET", "url": "{{base_url}}/api/location/forecast?lat=-6.2088&lng=106.8456" }
        }
      ]
    },
    {
      "name": "🚨 Escalation",
      "item": [
        {
          "name": "[1] Laporkan Situasi Darurat",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const r = pm.response.json();",
              "if (r.success && r.data.escalation_id) {",
              "  pm.collectionVariables.set('escalation_id', r.data.escalation_id);",
              "  console.log('Escalation ID:', r.data.escalation_id);",
              "}"
            ], "type": "text/javascript" }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/escalate",
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"location\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"city\": \"Jakarta Pusat\",\n    \"province\": \"DKI Jakarta\",\n    \"display_name\": \"Jakarta Pusat, DKI Jakarta\"\n  },\n  \"situation\": \"Banjir setinggi 1 meter masuk rumah. 4 orang terjebak termasuk 1 lansia dan 1 balita. Tidak bisa keluar.\",\n  \"contact_name\": \"Budi Santoso\",\n  \"contact_phone\": \"081234567890\"\n}" }
          }
        },
        {
          "name": "[2] Cek Status Laporan",
          "request": { "method": "GET", "url": "{{base_url}}/api/escalate/{{escalation_id}}" }
        }
      ]
    },
    {
      "name": "📚 Knowledge Base",
      "item": [
        {
          "name": "Statistik Knowledge Base",
          "request": { "method": "GET", "url": "{{base_url}}/api/knowledge/stats",
            "description": "Cek jumlah dokumen yang tersimpan di ChromaDB." }
        },
        {
          "name": "Search — Cara evakuasi banjir",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/knowledge/search",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"cara evakuasi saat banjir\",\n  \"n_results\": 3\n}" }
          }
        },
        {
          "name": "Search — Tas siaga bencana",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/knowledge/search",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"isi tas siaga bencana gempa\",\n  \"n_results\": 2\n}" }
          }
        },
        {
          "name": "Search — Pertolongan pertama luka",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/knowledge/search",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"pertolongan pertama korban luka dan perdarahan\",\n  \"n_results\": 3\n}" }
          }
        },
        {
          "name": "Search — Tanda longsor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/knowledge/search",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"tanda-tanda tanah longsor akan terjadi\",\n  \"n_results\": 2\n}" }
          }
        },
        {
          "name": "Reload Dataset dari JSON",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/knowledge/reload?dataset_path=app/data/disaster_knowledge.json",
            "description": "Reload knowledge base dari file dataset. Jalankan ini setelah update dataset JSON." }
        },
        {
          "name": "Reset Knowledge Base (Dev)",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/knowledge/reset",
            "description": "HATI-HATI: Hapus semua data knowledge base. Hanya bisa di development." }
        }
      ]
    }
  ]
}
